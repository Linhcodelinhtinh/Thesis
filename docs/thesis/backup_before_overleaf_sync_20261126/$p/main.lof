\contentsline {figure}{\numberline {3.1}{\ignorespaces Kiến trúc tổng thể của phương pháp.}}{18}{figure.caption.2}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Sự khác biệt về hiệu lực giữa sự kiện lịch sử và quan hệ hiện hành qua khoảng thời gian mất dấu hoặc che khuất.}}{21}{figure.caption.3}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Minh họa trục thời gian thể hiện mối quan hệ giữa thời điểm sự kiện diễn ra ($\tau $), thời điểm tích lũy đủ bằng chứng xác nhận ($\nu $), và thời điểm chính sách VLA truy vấn thông tin ($q$).}}{24}{figure.caption.4}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Minh họa cơ chế truy vấn sớm theo bằng chứng. Khi bộ nhớ xác nhận hoàn thành mốc tiến độ tại bước 2, bộ điều phối kích hoạt truy vấn sớm tại bước 3 thay vì chờ hết chu kỳ định kỳ $K = 10$.}}{29}{figure.caption.5}%
